{
  "name": "claude-sdk-typescript-starter-agent",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "Claude Agent SDK integration server for AG-UI",
  "scripts": {
    "dev": "tsx --watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "tsx --test src/agent.test.ts src/mcp.test.ts src/tools-api.test.ts src/model.test.ts src/run-errors.test.ts src/suggest.test.ts src/skills/skills.test.ts src/storage/api-embedder.test.ts src/storage/http.test.ts src/storage/tools.test.ts src/storage/workdir.test.ts src/memory/learn.test.ts",
    "test:integration": "node scripts/test-integration.mjs"
  },
  "dependencies": {
    "@ag-ui/claude-agent-sdk": "0.0.8",
    "@ag-ui/core": "1.0.4",
    "@ag-ui/encoder": "1.0.4",
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@anthropic-ai/sdk": "0.135.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@huggingface/transformers": "4.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "dotenv": "^16.4.0",
    "fflate": "0.8.3",
    "postgres": "^3.4.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ag-ui/client": "1.0.4",
    "@types/node": "^22.9.0",
    "rxjs": "7.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "adm-zip": "0.6.1",
    "body-parser": "2.4.0",
    "@ag-ui/client": "$@ag-ui/client"
  }
}
