# --- Claude Agent SDK (TypeScript) starter ---

# Your Anthropic API key (required). Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Claude model to use (optional; this is the default).
CLAUDE_MODEL=claude-sonnet-5

# Anthropic-compatible gateway such as OpenRouter or LiteLLM (optional). Model
# ids are passed through as written, e.g. CLAUDE_MODEL=openai/gpt-5.1.
# ANTHROPIC_BASE_URL=

# Follow-up chips after each reply come from one small-model call per reply
# (optional; default claude-haiku-5-5, or CLAUDE_MODEL when that isn't a
# Claude model). CHAT_SUGGESTIONS=static keeps the first-round chips instead
# and makes no extra calls.
# SUGGESTIONS_MODEL=claude-haiku-5-5
# CHAT_SUGGESTIONS=static

# Outside MCP servers the agent connects to, e.g. Python tools (optional): JSON
# or a path to a JSON file shaped like .mcp.json. See docs/development.md.
# MCP_SERVERS={"mcpServers":{"lab":{"url":"http://localhost:9100/mcp"}}}

# URL the Next.js runtime uses to reach the agent (optional; this is the default).
AGENT_URL=http://localhost:8000

# --- CopilotKit Intelligence (optional) ---
# Set CPK_INTELLIGENCE_API_KEY to activate the Threads drawer's live thread
# history (server + UI). Without it the drawer shows a locked state.
# COPILOTKIT_LICENSE_TOKEN= # self-hosted/offline only
# INTELLIGENCE_API_URL and INTELLIGENCE_GATEWAY_WS_URL point at a self-hosted
# or local Intelligence deployment only — leave them unset when using managed
# Intelligence, or the channel host and runtime will try to reach a local
# stack that usually is not running.
# INTELLIGENCE_API_URL=http://localhost:4201
# INTELLIGENCE_GATEWAY_WS_URL=ws://localhost:4401
# CPK_INTELLIGENCE_API_KEY=

# --- Runs (optional) ---
# Folders that make their parent folder a run (RUN_DIR), comma-separated.
# Read when the UI is built.
# RUN_DIR_MARKERS=xdoe-report

# Rules API for the Generate Rules action: GET <url>?run=<RUN_DIR> → JSON.
# Unset, the built-in mock answers; the same mock is served over HTTP here:
# RULES_API_URL=http://localhost:3000/api/mock/rules

# --- Workspace file storage (optional) ---
# Postgres for file metadata and versions, any S3-compatible store for bytes.
# `docker compose up -d` starts both locally with these values. Leave
# DATABASE_URL unset to run without storage (the /files API then answers 404).
# DATABASE_URL=postgres://knowledge:knowledge@localhost:5432/knowledge
# S3_ENDPOINT=http://localhost:8333   # omit for AWS S3
# S3_REGION=us-east-1
# S3_BUCKET=knowledge                 # created on startup if missing
# S3_ACCESS_KEY_ID=knowledge
# S3_SECRET_ACCESS_KEY=knowledge-secret
# S3_FORCE_PATH_STYLE=true            # false for AWS S3 virtual-host style
# MAX_UPLOAD_BYTES=52428800
# S3_PUBLIC_URL=http://localhost:8333 # the store as browsers reach it: binary
#                                     # downloads then use 5-minute signed links
# Search by meaning: a small multilingual embedding model runs inside the agent
# (downloaded once, about 120 MB) when Postgres has pgvector, as with docker
# compose. Without pgvector, or with EMBEDDING_MODEL=off, search matches words.
# EMBEDDING_MODEL=Xenova/multilingual-e5-small
# EMBEDDING_CACHE_DIR=/var/lib/knowledge/models  # default ~/.cache/knowledge-chatroom/models
# Or call an OpenAI-compatible embeddings API instead (passages then leave the
# server): a model you host behind LiteLLM, vLLM or Ollama, or OpenRouter/OpenAI.
# EMBEDDING_MODEL is then the name that endpoint knows. Switching re-embeds all.
# EMBEDDING_BASE_URL=https://openrouter.ai/api/v1  # or http://litellm:4000/v1
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_DIMENSIONS=1024           # optional; models over 2000 search unindexed
# SEARCH_MIN_SIMILARITY=0.4           # how close counts as a match; tune per model

# --- Login (optional) ---
# Without AUTH_SECRET there is no login: one built-in user owns everything.
# With it, users sign in through any OpenID Connect provider. The app and the
# agent must share the same AUTH_SECRET (at least 32 characters).
# AUTH_SECRET=              # openssl rand -hex 32
# OIDC_ISSUER=https://login.example.com/realms/knowledge
# OIDC_CLIENT_ID=knowledge-chatroom
# OIDC_CLIENT_SECRET=       # omit for a public client (PKCE only)
# APP_URL=https://knowledge.example.com   # the redirect URI is $APP_URL/api/auth/callback
# Skill hub admins verify hub skills and handle reports (emails or login
# subjects, comma-separated). Without login the built-in user is an admin.
# HUB_ADMINS=alice@example.com
# Let skills run the scripts they ship, in the SDK's sandbox (no network, only
# their own folder, no server secrets). Needs bubblewrap on the agent host.
# SKILL_SCRIPTS=on
# More paths scripts can't read, besides the app, its home and /run/secrets etc.
# SKILL_SCRIPTS_DENY_READ=/srv/credentials
