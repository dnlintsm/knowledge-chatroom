{
  "name": "knowledge-chatroom",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm dev:python",
    "dev:api": "node scripts/dev-py.mjs api-py",
    "dev:ui": "pnpm -C apps/web dev",
    "dev:agent-py": "node scripts/dev-py.mjs agent-py",
    "dev:python": "TS_AGENT_URL= concurrently \"pnpm dev:ui\" \"pnpm dev:api\" \"pnpm dev:agent-py\" --names ui,api,agent-py --prefix-colors blue,magenta,yellow --kill-others",
    "build": "pnpm -C apps/web build",
    "start": "pnpm -C apps/web start",
    "dev:debug": "LOG_LEVEL=debug pnpm dev",
    "typecheck": "tsc --noEmit && pnpm -C apps/web typecheck && pnpm -C packages/contracts typecheck",
    "typecheck:web": "tsc --noEmit && pnpm -C apps/web typecheck && pnpm -C packages/contracts typecheck",
    "test:preview": "pnpm test:e2e",
    "test": "pnpm test:unit",
    "test:unit": "playwright test --config playwright.unit.config.ts",
    "test:unit:web": "playwright test --config playwright.unit.config.ts",
    "test:conformance": "node scripts/test-conformance.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit",
    "check:web": "pnpm exec eslint apps/web packages/contracts tests/unit e2e scripts *.ts --max-warnings=0 --no-warn-ignored && pnpm typecheck:web && pnpm test:unit:web",
    "test:e2e": "node scripts/run-e2e.mjs browser",
    "test:e2e:storage": "node scripts/run-e2e.mjs storage",
    "test:e2e:login": "node scripts/run-e2e.mjs login",
    "test:e2e:python": "node scripts/run-e2e.mjs python",
    "test:e2e:python-storage": "node scripts/run-e2e.mjs python-storage",
    "test:live": "node scripts/run-e2e.mjs live",
    "lint": "eslint . --max-warnings=0",
    "env:check": "node scripts/env-upgrade.mjs",
    "env:upgrade": "node scripts/env-upgrade.mjs --write"
  },
  "devDependencies": {
    "@ag-ui/client": "1.0.2",
    "@eslint/js": "^10.0.1",
    "@knowledge-chatroom/contracts": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26",
    "concurrently": "^9.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "rxjs": "7.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "typescript-eslint": "^8.71.1"
  }
}
