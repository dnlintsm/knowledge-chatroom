{
  "name": "knowledge-chatroom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:ui\" \"npm run dev:agent\" --names ui,agent --prefix-colors blue,green --kill-others",
    "dev:agent": "./scripts/run-agent.sh || scripts\\run-agent.bat",
    "dev:ui": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "install:agent": "./scripts/setup-agent.sh || scripts\\setup-agent.bat",
    "postinstall": "npm run install:agent",
    "dev:debug": "LOG_LEVEL=debug npm run dev",
    "typecheck": "tsc --noEmit && cd agent && npm run typecheck",
    "test:preview": "playwright test",
    "test": "npm run test:unit",
    "test:unit": "playwright test --config playwright.unit.config.ts && npm --prefix agent run test:unit",
    "test:integration": "npm --prefix agent run test:integration",
    "check": "npm run typecheck && npm run test:unit"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@copilotkit/a2ui-renderer": "1.73.2",
    "@copilotkit/react-core": "1.73.2",
    "@copilotkit/runtime": "1.73.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "8.0.4",
    "dotenv": "^16.4.7",
    "hono": "^4.12.10",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "openid-client": "^6.8.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-is": "^19.2.4",
    "react-rnd": "^10.5.2",
    "react18-json-view": "^0.2.9",
    "recharts": "^3.7.0",
    "streamdown": "1.6.11",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "overrides": {
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59",
    "@ag-ui/encoder": "0.0.59",
    "@ag-ui/proto": "0.0.59"
  }
}
